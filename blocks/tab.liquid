{% doc %}
  Tab block for use with the tabbed-collections section.
  Configure the label and collection for each tab.

  @example
  {% content_for 'block', type: 'tab', id: 'tab-1' %}
{% enddoc %}

{% comment %}Rendering is handled by the parent tabbed-collections section.{% endcomment %}

{% schema %}
{
  "name": "t:names.tab",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:settings.label",
      "default": "Tab"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:settings.collection"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link",
      "info": "t:info.tab_link_override"
    }
  ]
}
{% endschema %}

{% doc %}
  Renders favicon and apple-touch-icon tags from theme settings.

  Google Search reads rel="icon" on the homepage (96x96 meets the >48px recommendation).
  apple-touch-icon is for iOS home screen bookmarks (180x180).
{% enddoc %}

{%- if settings.favicon != blank -%}
  <link
    rel="icon"
    type="image/png"
    sizes="96x96"
    href="{{ settings.favicon | image_url: width: 96, height: 96 }}"
  >
  <link
    rel="apple-touch-icon"
    sizes="180x180"
    href="{{ settings.favicon | image_url: width: 180, height: 180 }}"
  >
{%- endif -%}
